# Образец для сервера: скопируйте в .env.production и подставьте свои значения. Файл .env.production в git не попадает.
# Настоящие значения передаются лично, не через чат и почту.
# Пароль базы: длинная случайная строка — openssl rand -hex 24
POSTGRES_PASSWORD=
# Секрет сессий: не короче 32 символов — openssl rand -hex 32
PAYLOAD_SECRET=
# Адрес сайта
NEXT_PUBLIC_SITE_URL=https://cdumpo.ru
